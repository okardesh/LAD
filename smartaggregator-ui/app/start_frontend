#!/bin/sh
set -eu

BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$BASE_DIR"

if [ ! -f "env/dev.env" ]; then
  echo "Missing env/dev.env"
  exit 1
fi

set -a
. ./env/dev.env
set +a

PORT="${PORT:-8082}"
NODE_ENV="${NODE_ENV:-development}"

echo "Starting UI in real-backend mode (NODE_ENV=$NODE_ENV, PORT=$PORT)"
exec env NODE_ENV="$NODE_ENV" PORT="$PORT" node app.js
