extends ../layout
block content
    style.
    #main-wrapper.rpad-layout(data-theme='light', data-layout='vertical', data-navbarbg='skin6', data-sidebartype='full', data-sidebar-position='fixed', data-header-position='fixed', data-boxed-layout='full')
        include ../partials/header
        include ../partials/rpad-sidebar
        .page-wrapper(style="display:block; margin-bottom:5%")
            .container.data-groups.active.p-5
                .row 
                    .col-sm-12
                        div.table-div
                            table#host-table
                                thead 
                                    tr 
                                        th.col-1(style="background-color:#F5F5F5; width:100%;")  #{__('Host Machine Name')}
                                tbody
                                    each item in hosts
                                        tr
                                            if(item.hostMachineName != null)
                                                td.text-center(style="background-color: white; width:100%;")=item.hostMachineName != null ? item.hostMachineName : 'N/A'

    include ../partials/footer